@model IEnumerable<LaborProductivity.Models.ProductionOutput>

@{
    ViewData["Title"] = "Production Input";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Production Input</h2>
            <p class="text-muted mb-0">
                Kelola data Production Input.
            </p>
        </div>

        <a asp-controller="Production"
           asp-action="CreateProductionInput"
           class="btn btn-primary">
            + Add Production Input
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover">

                    <thead class="table-light">
                        <tr>
                            <th>Finish Date</th>
                            <th>Week</th>
                            <th>CC</th>
                            <th>Department</th>
                            <th>Product Group</th>
                            <th>Product Line</th>
                            <th>Quality Input</th>
                            <th style="width: 180px;">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.FinishDate.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @item.WeekNo
                                </td>

                                <td>
                                    @item.DataMaster?.CostCenter
                                </td>

                                <td>
                                    @item.DataMaster?.Department?.DepartmentName
                                </td>

                                <td>
                                    @item.DataMaster?.ProductGroup
                                </td>

                                <td>
                                    @item.DataMaster?.ProductLine
                                </td>

                                <td>
                                    @item.QualityInput
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-warning">
                                        Edit
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted">
                                    Belum ada data Production Input.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>