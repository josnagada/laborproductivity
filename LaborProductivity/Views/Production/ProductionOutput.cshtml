@model IEnumerable<LaborProductivity.Models.ProductionOutput>

@{
    ViewData["Title"] = "Production Output";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Production Output</h2>
            <p class="text-muted mb-0">
                Kelola data Production Output.
            </p>
        </div>

        <a asp-controller="Production"
           asp-action="CreateProductionOutput"
           class="btn btn-primary">
            + Add Production Output
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover">

                    <thead class="table-light">
                        <tr>
                            <th>Finish Date</th>
                            <th>Week</th>
                            <th>CC</th>
                            <th>Department</th>
                            <th>Product Group</th>
                            <th>Product Line</th>
                            <th>Quality Input</th>
                            <th>Quality Output</th>
                            <th style="width: 180px;">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.FinishDate.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @item.WeekNo
                                </td>

                                <td>
                                    @item.DataMaster?.CostCenter
                                </td>

                                <td>
                                    @item.DataMaster?.Department?.DepartmentName
                                </td>

                                <td>
                                    @item.DataMaster?.ProductGroup
                                </td>

                                <td>
                                    @item.DataMaster?.ProductLine
                                </td>

                                <td>
                                    @item.QualityInput.ToString("N2")
                                </td>

                                <td>
                                    @item.QualityOutput.ToString("N2")
                                </td>

                                <td>
                                    <a asp-controller="Production"
                                       asp-action="EditProductionOutput"
                                       asp-route-id="@item.ProductionOutputId"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <form asp-controller="Production"
                                          asp-action="DeleteProductionOutput"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.ProductionOutputId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Apakah Anda yakin ingin menghapus data Production Output ini?');">
                                            Delete
                                        </button>

                                    </form>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9"
                                    class="text-center text-muted">
                                    Belum ada data Production Output.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>