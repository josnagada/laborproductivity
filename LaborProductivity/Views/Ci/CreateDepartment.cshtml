@model LaborProductivity.Models.Department

@{
    ViewData["Title"] = "Add Department";
}

<div class="container-fluid">

    <h2 class="mb-4">Add Department</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="Ci"
                  asp-action="CreateDepartment"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label asp-for="DepartmentName"
                           class="form-label">
                        Department Name
                    </label>

                    <input asp-for="DepartmentName"
                           class="form-control"
                           placeholder="Contoh: Detection" />

                    <span asp-validation-for="DepartmentName"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save
                    </button>

                    <a asp-controller="Ci"
                       asp-action="DepartmentCategory"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
