@model LaborProductivity.Models.Baseline

@{
    ViewData["Title"] = "Edit Baseline";
}

<h1>Edit Baseline</h1>

<form asp-controller="Ci"
      asp-action="EditBaseline"
      asp-route-id="@Model.BaselineId"
      method="post">

    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values
                            .SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <!-- Department (hanya tampilan, tidak bisa diubah) -->
    <div class="form-group mb-3">
        <label>Department</label>
        <input type="text"
               class="form-control"
               value="@Model.DataMaster?.Department?.DepartmentName"
               disabled />
    </div>

    <!-- Cost Center (hanya tampilan, tidak bisa diubah) -->
    <div class="form-group mb-3">
        <label>Cost Center</label>
        <input type="text"
               class="form-control"
               value="@Model.DataMaster?.CostCenter"
               disabled />
    </div>

    <!-- Product Line (hanya tampilan, tidak bisa diubah) -->
    <div class="form-group mb-3">
        <label>Product Line</label>
        <input type="text"
               class="form-control"
               value="@Model.DataMaster?.ProductLine"
               disabled />
    </div>

    <!-- Year -->
    <div class="form-group mb-3">

        <label for="year">Year</label>

        <select class="form-control"
                id="year"
                name="year"
                required>

            @for (int y = 2015; y <= DateTime.Now.Year + 10; y++)
            {
                if (y == Model.Year)
                {
                    <option value="@y" selected>@y</option>
                }
                else
                {
                    <option value="@y">@y</option>
                }
            }

        </select>

    </div>

    <!-- Baseline Hour / Pc -->
    <div class="form-group mb-3">

        <label for="baselineHourPerPiece">Baseline Hour/Pc</label>

        <input type="number"
               class="form-control"
               id="baselineHourPerPiece"
               name="baselineHourPerPiece"
               step="0.00001"
               value="@Model.BaselineHourPerPiece"
               required />

    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a asp-controller="Ci"
       asp-action="Baseline"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
