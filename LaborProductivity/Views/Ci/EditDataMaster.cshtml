@model LaborProductivity.Models.DataMaster

@{
    ViewData["Title"] = "Edit Data Master";

    // Ambil daftar Department yang dikirim dari CiController
    var departments = ViewBag.Departments
        as IEnumerable<LaborProductivity.Models.Department>;
}

<div class="container-fluid">

    <h2 class="mb-4">Edit Data Master</h2>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-controller="Ci"
                  asp-action="EditDataMaster"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- ID Data Master -->
                <input type="hidden"
                       asp-for="DataMasterId" />


                <!-- Cost Center -->
                <div class="mb-3">

                    <label asp-for="CostCenter"
                           class="form-label">
                        Cost Center
                    </label>

                    <input asp-for="CostCenter"
                           class="form-control" />

                    <span asp-validation-for="CostCenter"
                          class="text-danger">
                    </span>

                </div>


                <!-- Department -->
                <div class="mb-3">

                    <label asp-for="DepartmentId"
                           class="form-label">
                        Department
                    </label>

                    <select asp-for="DepartmentId"
                            class="form-select">

                        <option value="0">
                            -- Select Department --
                        </option>

                        @if (departments != null)
                        {
                            foreach (var department in departments)
                            {
                                <option value="@department.DepartmentId">
                                    @department.DepartmentName
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="DepartmentId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Product Group -->
                <div class="mb-3">

                    <label asp-for="ProductGroup"
                           class="form-label">
                        Product Group
                    </label>

                    <input asp-for="ProductGroup"
                           class="form-control" />

                    <span asp-validation-for="ProductGroup"
                          class="text-danger">
                    </span>

                </div>


                <!-- Product Line -->
                <div class="mb-3">

                    <label asp-for="ProductLine"
                           class="form-label">
                        Product Line
                    </label>

                    <input asp-for="ProductLine"
                           class="form-control" />

                    <span asp-validation-for="ProductLine"
                          class="text-danger">
                    </span>

                </div>


                <!-- Tombol -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Update
                    </button>

                    <a href="/Ci/DataMaster"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
