@model IEnumerable<LaborProductivity.Models.DataMaster>

@{
    ViewData["Title"] = "Data Master";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Data Master</h2>

            <p class="text-muted mb-0">
                Kelola data Cost Center, Department, Product Group, dan Product Line.
            </p>
        </div>

        <a href="/Ci/CreateDataMaster"
           class="btn btn-primary">
            + Add Data Master
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead class="table-light">

                        <tr>
                            <th style="width: 70px;">No</th>
                            <th>Cost Center</th>
                            <th>Department</th>
                            <th>Product Group</th>
                            <th>Product Line</th>
                            <th style="width: 180px;">Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int no = 1;
                        }

                        @foreach (var data in Model)
                        {
                            <tr>

                                <td>
                                    @no
                                </td>

                                <td>
                                    @data.CostCenter
                                </td>

                                <td>
                                    @data.Department?.DepartmentName
                                </td>

                                <td>
                                    @data.ProductGroup
                                </td>

                                <td>
                                    @data.ProductLine
                                </td>

                                <td>
                                    <a href="/Ci/EditDataMaster/@data.DataMasterId"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <form action="/Ci/DeleteDataMaster/@data.DataMasterId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Apakah Anda yakin ingin menghapus data master ini?');">
                                            Delete
                                        </button>

                                    </form>
                                </td>

                            </tr>

                            no++;
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted">
                                    Belum ada data master.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
