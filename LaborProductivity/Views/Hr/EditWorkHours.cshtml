@model LaborProductivity.Models.WorkHoursViewModel

@{
    ViewData["Title"] = "Edit Work Hours";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Edit Work Hours</h2>

        <a asp-controller="WorkHours"
           asp-action="Index"
           class="btn btn-secondary">
            Kembali
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="WorkHours"
                  asp-action="Edit"
                  asp-route-id="@ViewContext.RouteData.Values["id"]"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Menampilkan pesan validasi/error -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!--
                    Data berikut tidak diedit.
                    Kita tetap kirim nilainya menggunakan hidden input
                    agar controller menerima data tersebut saat POST.
                -->
                <input type="hidden"
                       asp-for="FiscalYear" />

                <input type="hidden"
                       asp-for="WeekNo" />

                <input type="hidden"
                       asp-for="DataMasterId" />

                <div class="row">

                    <!-- Fiscal Year -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Fiscal Year
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.FiscalYear"
                               readonly />
                    </div>

                    <!-- Fiscal Week -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Fiscal Week
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.WeekNo"
                               readonly />
                    </div>

                    <!-- CC - Product Group -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            CC - Product Group
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(
                               Model.DataMasters
                                   .FirstOrDefault(dm => dm.DataMasterId == Model.DataMasterId)
                                   is var dataMaster && dataMaster != null
                                   ? dataMaster.CostCenter + " - " + dataMaster.ProductGroup
                                   : "-"
                                                              )"
                               readonly />
                    </div>

                    <!-- Work Date -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Work Date
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.WorkDate.HasValue
                                                                  ? Model.WorkDate.Value.ToString("dd-MM-yyyy")
                                                                  : "-")"
                               readonly />
                    </div>

                    <!-- Normal Hours -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="NormalHours"
                               class="form-label">
                        </label>

                        <input asp-for="NormalHours"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="NormalHours"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- Work Hours -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="WorkHoursValue"
                               class="form-label">
                        </label>

                        <input asp-for="WorkHoursValue"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="WorkHoursValue"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Simpan Perubahan
                    </button>

                    <a asp-controller="WorkHours"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Batal
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
